# LLM provider selection: "openai" | "gemini" | "local" | "none"
#   local  → Ollama (tamamen offline, GPU/CPU ile calisan yerel LLM)
#   none   → Extractive mod (LLM olmadan dogrudan belgeden cevap)
LLM_PROVIDER=gemini

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point the OpenAI profile to an OpenAI-compatible backend.
# Example for Gemini OpenAI compatibility:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Gemini
# Set LLM_PROVIDER=gemini to enable Gemini.
GEMINI_API_KEY=
# Vertex AI (optional): explicit config, same style as SimTTSLocal.
# VERTEX_ENABLED=1
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_LOCATION=global
# Optional model-specific fallback location. Example:
# - gemini-3.1-pro-*  -> VERTEX_LOCATION
# - gemini-2.5-pro-*  -> VERTEX_FALLBACK_LOCATION
# VERTEX_FALLBACK_LOCATION=europe-west4
# VERTEX_REQUEST_TIMEOUT_MS=120000
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/service-account.json
# Model notes:
# - If you get 404 NOT_FOUND for a model name, it may not be enabled for your account/project.
# - Recommended max-quality target: gemini-3.1-pro-preview
# - Current single automatic fallback: gemini-2.5-pro
GEMINI_MODEL=gemini-3.1-pro-preview
# Alternative:
# GEMINI_MODEL=gemini-2.5-pro
# Optional fallback if primary model is unavailable.
GEMINI_FALLBACK_MODEL=gemini-2.5-pro

# Embeddings
# Document processing mode:
# - classic: current text-first pipeline
# - multimodal: adds visual page chunks and multimodal retrieval/generation path
DOC_PROCESSING_MODE=classic
# Multimodal answer generation:
# - off: always text-only generation
# - auto: only attach visual evidence for visual/layout-dependent questions
# - on: if visual evidence exists, always use it in Gemini generation
# Only meaningful when DOC_PROCESSING_MODE=multimodal and Gemini generation is active.
MULTIMODAL_ANSWER_MODE=auto
# Visual chunk granularity:
# - page: current stable page-level visual chunking
# - region: experimental vertical region crop chunks (top/middle/bottom style)
# Only meaningful when DOC_PROCESSING_MODE=multimodal.
VISUAL_CHUNK_LEVEL=page
# Region proposal source:
# - heuristic: current crop planner
# - detector: use a bbox detector backend
VISUAL_REGION_SOURCE=heuristic
# Detector backend:
# - none: no detector backend, detector source falls back to heuristic
# - sidecar: read bbox proposals from JSON sidecar files
# - docai: Google Document AI Layout Parser
# - docling: local Docling layout detector (supports docling-layout-heron-101)
VISUAL_DETECTOR_BACKEND=none
# Sidecar detector directory (used only when VISUAL_DETECTOR_BACKEND=sidecar)
VISUAL_DETECTOR_DIR=./data/layout_sidecars
# Document AI Layout Parser (used only when VISUAL_DETECTOR_BACKEND=docai)
DOCAI_PROJECT_ID=
DOCAI_LOCATION=us
DOCAI_LAYOUT_PROCESSOR_ID=
DOCAI_LAYOUT_PROCESSOR_VERSION=pretrained-layout-parser-v1.6-pro-2025-12-01
DOCAI_TIMEOUT_SECONDS=120
# Docling layout backend (used only when VISUAL_DETECTOR_BACKEND=docling)
# Optional: point this to another venv/python that has `docling` installed.
DOCLING_PYTHON_BIN=
DOCLING_LAYOUT_MODEL=docling-layout-heron-101
DOCLING_ARTIFACTS_PATH=
DOCLING_DEVICE=auto
# Optional structured table extraction stage.
# Recommended: keep auto; if DOCAI_TABLE_PROCESSOR_ID is set, Document AI table parsing is tried first.
TABLE_STRUCTURE_ENABLED=0
TABLE_STRUCTURE_BACKEND=auto
TABLE_STRUCTURE_MIN_CONFIDENCE=0.55
TABLE_STRUCTURE_GEMINI_MODEL=
DOCAI_TABLE_PROCESSOR_ID=
DOCAI_TABLE_PROCESSOR_VERSION=
#
# Embedding model selection:
# - Default max-quality remote option: gemini-embedding-001
# - Optional multimodal preview option: gemini-embedding-2-preview
# - "auto": local fallback (CUDA varsa e5-base, yoksa e5-small)
# - or set a fixed local model name (e.g. intfloat/multilingual-e5-small)
EMBEDDING_MODEL=gemini-embedding-001
# Gemini embedding output size. Max quality: 3072
EMBEDDING_DIMENSION=3072
# Device selection for embeddings: auto | cpu | cuda
# - Only affects local SentenceTransformers models
# - auto: use CUDA if available, else CPU
# - cpu: force CPU even if CUDA exists
# - cuda: prefer CUDA, fall back to CPU if unavailable
EMBEDDING_DEVICE=auto
# Vertex AI bypass for embedding (optional).
# Some GCP projects do not have gemini-embedding-2-preview allowlisted on Vertex AI.
# Set to 0 to use GEMINI_API_KEY directly for embedding (AI Studio path).
# When unset or 1, embedding uses Vertex AI (same as VERTEX_ENABLED).
# EMBEDDING_VERTEX_ENABLED=0
# Optional: separate Vertex location for embedding only.
# EMBEDDING_VERTEX_LOCATION=us-central1

# Storage
DATA_DIR=./data
CHROMA_DIR=./data/chroma

# OCR (optional)
# OCR toggle:
# - 1: enable OCR backend when PDF text layer is weak / image document is uploaded
# - 0: disable OCR and rely on PDF text layer + VLM extraction
OCR_ENABLED=0
# OCR backend:
# - docai: Google Document AI Enterprise Document OCR (online / recommended)
# - paddle_vl: PaddleOCR-VL-1.5 advanced backend (requires optional local Paddle packages)
# - paddle: classic PaddleOCR backend (requires optional local Paddle packages)
# - tesseract_legacy: legacy fallback
OCR_BACKEND=docai
# OCR language hint.
# - Tesseract uses values like "tur+eng"
# - Paddle backends map this hint approximately (`tur+eng` -> `tr`)
# - Document AI may ignore or partially use this hint
OCR_LANG=tur+eng
# OCR device hint for local Paddle backends: auto | cpu | cuda
OCR_DEVICE=auto
# Local PaddleOCR model family. Current default keeps the stronger general OCR line.
PADDLE_OCR_VERSION=PP-OCRv5
#
# If OCR_BACKEND=tesseract_legacy and tesseract isn't on PATH, set a full path, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Tesseract language data folder (optional).
# Use this if you cannot write to Program Files (no admin) and want to keep traineddata files locally.
# Example:
# TESSDATA_PREFIX=C:\path\to\project\data\tessdata
TESSDATA_PREFIX=

# Advanced legacy OCR (optional): pass through to pytesseract `config=`
# Examples:
# - "--psm 6 --oem 3"
# - "--psm 4"
TESSERACT_CONFIG=
# Document AI OCR (used only when OCR_BACKEND=docai)
DOCAI_OCR_PROCESSOR_ID=
# Optional. Leave empty to use the processor's default version.
DOCAI_OCR_PROCESSOR_VERSION=

# VLM (optional): multimodal extract-only text extraction for complex layouts (tables/multi-column).
# Values: off | auto | force
VLM_MODE=force
# Safety cap: max pages per document to send to VLM
VLM_MAX_PAGES=50
# VLM provider: "gemini" (default) | "local" (Ollama vision model)
VLM_PROVIDER=gemini

# ── Local / Ollama (offline) ayarlari ────────────────────────────────────────
# Bu ayarlar yalnizca LLM_PROVIDER=local ve/veya VLM_PROVIDER=local iken kullanilir.
# Ollama kurulumu: https://ollama.com/download
#
# Ollama calistigin sunucu adresi:
OLLAMA_BASE_URL=http://localhost:11434
#
# Text LLM model adi (ollama pull <model> ile indir):
# Onerilen: qwen2.5:7b (6 GB VRAM icin Q4 quantize)
OLLAMA_LLM_MODEL=qwen2.5:7b
#
# Vision (multimodal) model adi:
# Onerilen: llava:7b (gorsel icerik cikarimi icin)
OLLAMA_VLM_MODEL=llava:7b
#
# HTTP istek zaman asimi (saniye):
OLLAMA_TIMEOUT=120

# Retrieval (optional): section subtree fetch depth for section_list intent.
# Default keeps current behavior (≈ children + grandchildren).
SECTION_FETCH_MAX_DEPTH=2

# Retrieval confidence (optional): the deterministic section-list rendering
# path now verifies that the query's topic words have lexical overlap with
# the matched section heading.  If there is no overlap the system falls
# through to the LLM path which can evaluate relevance and respond
# "Belgede bu bilgi bulunamadi." when appropriate.
# This setting requires no configuration — it is always active.

# ── RAG Retrieval & Routing Thresholds ───────────────────────────────────────
# These tune the hybrid search, truncation limits, and multi-query expansion.
# They all have sensible defaults but can be overridden.
# 
# Blend weight preferring embeddings (vs BM25 RRF). Default: 0.6
# RERANK_BLEND_WEIGHT=0.6
#
# Minimum relative score ratio for keeping evidence. Default: 0.25 (keeps evidence with score at least 25% of top score)
# RELEVANCE_MIN_SCORE_RATIO=0.25
# 
# Irrespective of the ratio, keep at least this many evidences. Default: 3
# RELEVANCE_MIN_KEEP=3
# 
# Minimum average grounding score required to send context to the generator. Default: 0.15
# GROUNDING_MIN_AVG_SCORE=0.15
# 
# Maximum number of sections to fetch for a multi-section intent query. Default: 3
# MULTI_SECTION_MAX=3
# 
# LLM context window maximum token limit (using tiktoken). Default: 100000
# CONTEXT_MAX_TOKENS=100000
# 
# Enable semantic multi-query expansion using Gemini. Default: 0
# QUERY_EXPANSION_ENABLED=0

# Logging (optional): persist Q/A logs to JSONL (OFF by default).
# This logs the user query + answer + retrieval metadata.
RAG_LOG=0
RAG_LOG_DIR=./data/logs
# Also write a per-document log file under <dir>/by_doc/<doc>.jsonl
RAG_LOG_BY_DOC=1
# Include GenerationResult.context_preview (truncated) in logs.
RAG_LOG_CONTEXT_PREVIEW=0
# Clamp big strings to avoid huge logs.
RAG_LOG_MAX_TEXT_CHARS=4000

# Dev convenience (optional): if enabled, the server process will exit after the last
# browser tab disconnects. Helps avoid "port already in use" on restart.
AUTO_EXIT_ON_NO_CLIENTS=0
# Grace seconds before exiting (0-120).
AUTO_EXIT_GRACE_SECONDS=8

# ── Thread Persistence (optional) ────────────────────────────────────────────
# Per-thread UI conversation history is also stored as JSON files under
# DATA_DIR/thread_history by default so old conversations can be reopened.
# Optional override:
# THREAD_HISTORY_DIR=./data/thread_history

# Native Chainlit thread history (optional, OFF by default).
# This is separate from the JSON thread replay fallback above.
#
# When enabled, Chainlit can use its native thread list/resume flow.
# Safe rollout path:
# 1) install optional deps: sqlalchemy + aiosqlite
# 2) set CHAINLIT_NATIVE_HISTORY=1
# 3) for local single-user use, also set CHAINLIT_AUTH_USERNAME/PASSWORD
#
# If CHAINLIT_HISTORY_DATABASE_URL is empty, the app falls back to:
# - DATABASE_URL if set
# - otherwise CHAINLIT_DB_PATH / DATA_DIR/chainlit_history.db (sqlite)
CHAINLIT_NATIVE_HISTORY=0
CHAINLIT_HISTORY_DATABASE_URL=
CHAINLIT_DB_PATH=./data/chainlit_history.db

# Optional local login for native Chainlit history.
# Leave empty to keep the current no-login behavior.
# Note: native thread listing/resume needs an authenticated Chainlit user.
CHAINLIT_AUTH_USERNAME=
CHAINLIT_AUTH_PASSWORD=
CHAINLIT_AUTH_DISPLAY_NAME=


